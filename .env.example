# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Zoho Mail SMTP (for lead notification emails)
# Use your compliance@almadentrade.com credentials
ZOHO_EMAIL=compliance@almadentrade.com
ZOHO_PASSWORD=your_zoho_app_password_here

# Vercel Blob (for label image storage)
# Auto-provided by Vercel when you enable Blob storage in your project settings
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here
